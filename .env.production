# Deployed build: POC "dbku" on astrikos.xyz, frontend 3303, backend 4303 (see DEPLOY.md).
# Read by `npm run build` (only REACT_APP_* reach the browser bundle) and by server/index.js.
# No secrets here: this file is committed. Put ANTHROPIC_API_KEY in .env on the server.

# Frontend → backend. One backend host carries all API traffic (the app has no websockets).
REACT_APP_API_URL=https://dbku-api.astrikos.xyz:8443

# Backend: browser origins allowed to call the API (comma-separated).
CORS_ORIGIN=https://dbku.astrikos.xyz:8443
