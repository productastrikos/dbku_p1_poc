# Copy to .env.local (git-ignored) and fill in.
# The key is read by the server-side routes in server/llm.js only; it is never bundled into the browser app.
ANTHROPIC_API_KEY=

# Optional
# ANTHROPIC_MODEL=claude-opus-5-5
# GUARDGRID_LLM=off        # force the offline template fallback
# PORT=8080                # npm run serve
