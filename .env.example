# Copy to .env.local (git-ignored) for development, or to .env on the server, and fill in.
# The key is read by the server-side routes in server/llm.js only; it is never bundled into the browser app.
ANTHROPIC_API_KEY=

# Optional
# ANTHROPIC_MODEL=claude-opus-5-5
# GUARDGRID_LLM=off        # force the offline template fallback

# Production backend (server/index.js). PORT is passed on the pm2 command; the
# deployed values of REACT_APP_API_URL and CORS_ORIGIN live in .env.production.
# PORT=4303
# CORS_ORIGIN=https://dbku.astrikos.xyz:8443
